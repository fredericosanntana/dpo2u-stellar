# Pulso × DeFindex quickstart — copy to `.env` in this folder and fill in.
#
# A funded Stellar **testnet** identity (managed by the `stellar` CLI) is required
# for the POSITIVE (value-moving) lane. The READINESS and NEGATIVE lanes are
# read-only / simulation-only and do not spend.

# stellar CLI identity name (run `stellar keys ls` to list, `stellar keys generate`
# + friendbot to fund). The POSITIVE lane signs with this.
IDENTITY=dpo2u-deployer
NETWORK=testnet

# Proven-live testnet addresses from the original proof-bound slice.
# Override these to target your OWN fresh vault (see setup-fresh-vault below).
GATE=CDVOKZMLIAHSESPHH47K76X2OYYOSDFRHXSUHLXV6JRCQRYRE4SWNL3E
VAULT=CB5YHBXELSXGNWGJURUD5W23C4VVRIN7CX4WMDNZ7FR5TUVNEJPEOF5W
VERIFIER=CBM6WJTENB7MT6MZCGA4KOVEDBLOGHKOGFDHBCJRPQ5TINTU6EDMVCAC
STRATEGY=CDVLOSPJPQOTB6ZCWO5VSGTOLGMKTXSFWYTUP572GTPNOWX4F76X3HPM

# Rebalance intent used by the positive/negative lanes.
SCOPE=invest
AMOUNT=500000

# Safety: the POSITIVE lane only submits when SEND=yes (it spends testnet funds).
# Default `no` keeps the whole demo non-spending (readiness + simulated negative).
SEND=no
